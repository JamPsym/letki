	(text "STUDY C: requires v3_1-pulse firmware, NOT v3_1-mosfet or original v3.\nR1-R8 + R58-R65: two 68R in parallel per row = 34R nominal.\nHardware OPM/PWM2: <=80us GPIO gate pulses every nominal 1ms per pixel.\nLED rating: 80mA max ONLY for <=100us and duty<=10%, at 25C.\nExpected current is illustrative ~35mA pulse; current/temperature/gate tails need scope checks.\nCommon regulated 3.3V +/-5%. Five-tile power head target >=3A, recheck transients.\nNO PCB, FLASH, ORDER OR PHYSICAL QUALIFICATION."
		(at 342.9 266.7 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "f43781e5-7411-4b91-93fb-414b704fc652")
	)
)
