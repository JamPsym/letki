(version 1)
# JLCPCB published NPTH-to-track minimum, verified 2026-10-11.
# The HRO recommended lands leave ~0.219 mm around its 0.60 mm locators.
(rule "NPTH copper clearance"
    (condition "A.Pad_Type == 'NPTH, mechanical'")
    (constraint hole_clearance (min 0.2mm)))
# PTH copper remains subject to the fabricator's larger hole-to-track minimum.
(rule "PTH copper clearance"
    (condition "A.Pad_Type == 'Through-hole'")
    (constraint hole_clearance (min 0.28mm)))
