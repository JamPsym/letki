# Hardware projects: keep only the main KiCad sources
hw/**
!hw/**/
!hw/**/*.kicad_pcb
!hw/**/*.kicad_pro
!hw/**/*.kicad_sch
!hw/**/*.FCStd
!hw/**/README.md
!hw/**/*.txt
!hw/**/*.json
!hw/**/*.csv
!hw/**/*.kicad_sym
!hw/**/*.kicad_mod
!hw/**/*.kicad_dru
!hw/**/sym-lib-table
!hw/**/fp-lib-table
!hw/**/Letki.3dshapes/*.step

# Archived hardware follows the same source-only tracking policy
archive/hw/**
!archive/hw/**/
!archive/hw/**/*.kicad_pcb
!archive/hw/**/*.kicad_pro
!archive/hw/**/*.kicad_sch
!archive/hw/**/*.FCStd
!archive/hw/**/README.md
!archive/hw/**/*.md
!archive/hw/**/*.kicad_sym
!archive/hw/**/*.kicad_mod
!archive/hw/**/*.kicad_dru
!archive/hw/**/sym-lib-table
!archive/hw/**/fp-lib-table
!archive/hw/**/Letki.3dshapes/*.step
!archive/hw/**/*.json
!archive/hw/**/*.txt
!archive/hw/**/*.csv
!archive/hw/**/*.py

# Native builds, local tools and preserved migration artifacts
/build/
/.tools/
/.local/
/config/local.mk
**/obj/
**/.mrs/
**/.cache/
**/compile_commands.json
*.swp
*.swo
.DS_Store
__pycache__/
*.pyc
hw/**/exports/
archive/hw/**/exports/

# CAD/editor state and generated files, including beneath metadata exceptions
**/.history/
**/*-backups/
**/backups/
*.kicad_prl
*.kicad_pcb-bak
*.kicad_sch-bak
*.FCStd1
*.lck
*.log
/result.json

# Shared inventory is canonical outside this checkout; see config/README.md
/config/parts-stock.csv
/config/parts-stock-source.json
/config/parts-incoming.csv
/config/smd-storage.json
/config/board-reservations.json
/config/orders/TME-35700057-source.json
/config/orders/TME-35700057-backorders.csv
